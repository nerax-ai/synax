{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["bun-types"],
    "paths": {
      "@synax-ai/sdk": ["./packages/sdk/src"],
      "@synax-ai/core": ["./packages/core/src"],
      "@synax-ai/server": ["./packages/server/src"],
      "synax-ai": ["./packages/cli/src"]
    }
  }
}
